{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/catalog.json",
      "destination": "https://agentsflix.github.io/skills/catalog.json"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://agentsflix.github.io/skills/.well-known/:path*"
    },
    {
      "source": "/prompt/:path*",
      "destination": "https://agentsflix.github.io/skills/prompt/:path*"
    },
    {
      "source": "/covers/:path*",
      "destination": "https://agentsflix.github.io/skills/covers/:path*"
    },
    {
      "source": "/download/:tag/:file",
      "destination": "https://github.com/AgentsFlix/skills/releases/download/:tag/:file"
    }
  ],
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
